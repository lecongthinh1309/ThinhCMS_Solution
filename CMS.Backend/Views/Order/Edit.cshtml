@model CMS.Data.Entities.Order

<div class="px-6 py-6 max-w-lg mx-auto">
    <h2 class="text-2xl font-bold text-zinc-900 mb-6">Cập nhật đơn hàng #@Model.Id</h2>

    <form asp-action="Edit" class="bg-white p-6 rounded-xl border border-zinc-200 shadow-sm">
        <input type="hidden" asp-for="Id" />

        <div class="mb-4">
            <label class="block text-sm font-bold text-zinc-700 mb-2">Trạng thái đơn hàng</label>
            <select asp-for="Status" class="w-full p-2.5 border border-zinc-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                <option value="0">Chờ duyệt</option>
                <option value="1">Đang giao</option>
                <option value="2">Đã xong</option>
            </select>
        </div>

        <div class="mb-6">
            <label class="block text-sm font-bold text-zinc-700 mb-2">Ghi chú</label>
            <textarea asp-for="Notes" class="w-full p-2.5 border border-zinc-300 rounded-lg" rows="3"></textarea>
        </div>

        <div class="flex gap-4">
            <button type="submit" class="flex-1 bg-indigo-600 text-white font-bold py-2.5 rounded-lg hover:bg-indigo-700">Lưu thay đổi</button>
            <a asp-action="Index" class="flex-1 text-center bg-zinc-100 text-zinc-700 font-bold py-2.5 rounded-lg hover:bg-zinc-200">Hủy</a>
        </div>
    </form>
</div>