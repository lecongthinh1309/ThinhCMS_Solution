@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container mx-auto px-4 mt-6 max-w-6xl">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h2 class="text-2xl font-bold text-gray-800 tracking-wide uppercase">Danh sách sản phẩm</h2>
            <p class="text-sm text-gray-500 mt-1">
                Tổng cộng <strong>@totalItems</strong> sản phẩm — Trang <strong>@currentPage</strong>/@totalPages
            </p>
        </div>
        <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2.5 rounded-lg shadow transition duration-200 text-sm">
            + THÊM SẢN PHẨM MỚI
        </a>
    </div>

    <div class="bg-white shadow-md rounded-lg overflow-hidden border border-gray-200">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Hình ảnh</th>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Tên sản phẩm</th>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Danh mục</th>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Giá bán</th>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Số lượng kho</th>
                    <th class="px-6 py-3.5 text-center text-xs font-bold text-gray-500 uppercase tracking-wider">Thao tác</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200 text-sm">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 whitespace-nowrap">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="w-16 h-16 object-cover rounded-md border shadow-sm" alt="@item.Name" />
                            }
                            else
                            {
                                <div class="w-16 h-16 bg-gray-100 flex items-center justify-center text-gray-400 rounded-md border text-xs">No Image</div>
                            }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap font-semibold text-gray-900">@item.Name</td>
                        <td class="px-6 py-4 whitespace-nowrap text-gray-600">@item.CategoryProduct?.Name</td>
                        <td class="px-6 py-4 whitespace-nowrap font-bold text-red-600">@item.Price.ToString("N0") đ</td>
                        <td class="px-6 py-4 whitespace-nowrap text-gray-700 font-medium">@item.StockQuantity</td>
                        <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-indigo-600 hover:text-indigo-900 mr-3 inline-block font-semibold">Sửa</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-red-600 hover:text-red-900 ml-3 inline-block font-semibold">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ===== THANH PHÂN TRANG ===== *@
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-center gap-2 mt-8 flex-wrap">
            @* Nút Trước *@
            @if (currentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(currentPage - 1)"
                   class="inline-flex items-center gap-1 px-3 py-2 rounded-lg bg-white border border-gray-200 text-gray-600 hover:bg-blue-50 hover:border-blue-300 text-sm font-medium transition-all shadow-sm">
                    <i class="bi bi-chevron-left"></i> Trước
                </a>
            }
            else
            {
                <span class="inline-flex items-center gap-1 px-3 py-2 rounded-lg bg-gray-100 border border-gray-200 text-gray-400 text-sm font-medium cursor-not-allowed">
                    <i class="bi bi-chevron-left"></i> Trước
                </span>
            }

            @* Số trang *@
            @for (int p = 1; p <= totalPages; p++)
            {
                if (p == currentPage)
                {
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-blue-600 text-white text-sm font-bold shadow">
                        @p
                    </span>
                }
                else if (p == 1 || p == totalPages || (p >= currentPage - 2 && p <= currentPage + 2))
                {
                    <a asp-action="Index" asp-route-page="@p"
                       class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-white border border-gray-200 text-gray-700 hover:bg-blue-50 hover:border-blue-300 text-sm font-medium transition-all shadow-sm">
                        @p
                    </a>
                }
                else if (p == currentPage - 3 || p == currentPage + 3)
                {
                    <span class="inline-flex items-center justify-center w-10 h-10 text-gray-400 text-sm">...</span>
                }
            }

            @* Nút Sau *@
            @if (currentPage < totalPages)
            {
                <a asp-action="Index" asp-route-page="@(currentPage + 1)"
                   class="inline-flex items-center gap-1 px-3 py-2 rounded-lg bg-white border border-gray-200 text-gray-600 hover:bg-blue-50 hover:border-blue-300 text-sm font-medium transition-all shadow-sm">
                    Sau <i class="bi bi-chevron-right"></i>
                </a>
            }
            else
            {
                <span class="inline-flex items-center gap-1 px-3 py-2 rounded-lg bg-gray-100 border border-gray-200 text-gray-400 text-sm font-medium cursor-not-allowed">
                    Sau <i class="bi bi-chevron-right"></i>
                </span>
            }
        </div>
        <p class="text-center text-xs text-gray-400 mt-3">Trang @currentPage / @totalPages (@totalItems sản phẩm)</p>
    }
</div>