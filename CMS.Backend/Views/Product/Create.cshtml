@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="max-w-2xl mx-auto mt-8 bg-white p-8 rounded-xl shadow-md border border-gray-100">
    <h2 class="text-xl font-bold text-gray-800 mb-6 border-b pb-3 uppercase tracking-wide">Thêm sản phẩm mới</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

        <div>
            <label asp-for="CategoryProductId" class="block text-sm font-semibold text-gray-700 mb-1">Danh mục sản phẩm</label>
            <select asp-for="CategoryProductId" class="w-full border border-gray-300 px-3 py-2 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" asp-items="ViewBag.CategoriesProducts">
                <option value="">-- Chọn danh mục --</option>
            </select>
            <span asp-validation-for="CategoryProductId" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-1">Tên sản phẩm</label>
            <input asp-for="Name" class="w-full border border-gray-300 px-3 py-2 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" placeholder="Nhập tên sản phẩm..." />
            <span asp-validation-for="Name" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="Price" class="block text-sm font-semibold text-gray-700 mb-1">Giá bán (VNĐ)</label>
                <input asp-for="Price" type="number" class="w-full border border-gray-300 px-3 py-2 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" />
                <span asp-validation-for="Price" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            <div>
                <label asp-for="StockQuantity" class="block text-sm font-semibold text-gray-700 mb-1">Số lượng kho</label>
                <input asp-for="StockQuantity" type="number" class="w-full border border-gray-300 px-3 py-2 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" />
                <span asp-validation-for="StockQuantity" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>

        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Hình ảnh sản phẩm</label>
            <input type="file" name="imageFile" accept="image/*" class="w-full border border-gray-300 px-3 py-2 rounded-lg text-sm text-gray-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
        </div>

        <div>
            <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-1">Mô tả sản phẩm</label>
            <textarea asp-for="Description" id="Description" rows="4" class="w-full border border-gray-300 px-3 py-2 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" placeholder="Nhập mô tả chi tiết..."></textarea>
            <span asp-validation-for="Description" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div class="flex justify-between items-center pt-4 border-t border-gray-100">
            <a asp-action="Index" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-4 py-2 rounded-lg text-sm transition">Quay lại</a>
            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-semibold px-5 py-2 rounded-lg text-sm shadow transition">Lưu sản phẩm</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('Description', {
            language: 'vi',
            filebrowserUploadUrl: '/api/Upload',
            filebrowserUploadMethod: 'form'
        });
    </script>
}