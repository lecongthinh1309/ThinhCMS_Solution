@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Xác nhận xóa sản phẩm";
}

<div class="max-w-md mx-auto mt-16 bg-white border border-red-100 rounded-xl shadow-lg overflow-hidden">
    <div class="bg-red-50 p-4 border-b border-red-100 text-center">
        <h2 class="text-xl font-bold text-red-600 uppercase tracking-wide">Cảnh báo xóa dữ liệu</h2>
    </div>

    <div class="p-6 text-center space-y-4">
        <p class="text-gray-600">Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm dưới đây không?</p>

        <div class="bg-gray-50 p-4 rounded-lg border text-left space-y-2">
            <div><span class="text-xs font-bold uppercase text-gray-400">Tên sản phẩm:</span> <strong class="text-gray-800 block">@Model.Name</strong></div>
            <div><span class="text-xs font-bold uppercase text-gray-400">Danh mục:</span> <span class="text-gray-700 block">@Model.CategoryProduct?.Name</span></div>
            <div><span class="text-xs font-bold uppercase text-gray-400">Giá bán:</span> <span class="text-red-600 font-bold block">@Model.Price.ToString("N0") đ</span></div>
        </div>

        <form asp-action="Delete" method="post" class="flex justify-center space-x-3 pt-4">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-5 py-2 rounded-lg text-sm transition">Hủy</a>
            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-5 py-2 rounded-lg text-sm shadow transition">Xác nhận xóa</button>
        </form>
    </div>
</div>