@model CMS.Data.Entities.CategoryProduct

@{
    ViewData["Title"] = "Thêm mới Danh mục";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-12 col-xl-6 mx-auto">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Tạo Danh Mục Sản Phẩm Mới</h6>
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Tên danh mục (*)</label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục (ví dụ: Áo Sơ Mi, Quần Jean)..." required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Mô tả chi tiết</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập tóm tắt mô tả về nhóm sản phẩm này..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-2"></i>Lưu dữ liệu</button>
                        <a class="btn btn-secondary ms-2" asp-action="Index">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>