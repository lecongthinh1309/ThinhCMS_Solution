@{
    Layout = "_Layout";
}
@model IEnumerable<CMS.Data.Entities.Category>

<div class="px-4 sm:px-6 lg:px-8">
    <div class="sm:flex sm:items-center justify-between mb-8">
        <div>
            <h2 class="text-2xl font-bold text-zinc-900">Quản lý danh mục</h2>
            <p class="mt-2 text-sm text-zinc-600">Danh sách các danh mục sản phẩm hiện có trên hệ thống.</p>
        </div>
        <div class="mt-4 sm:mt-0">
            <a asp-action="Create" class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 transition-all duration-200">
                <i class="bi bi-plus-lg mr-2"></i> Thêm danh mục mới
            </a>
        </div>
    </div>

    <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-zinc-200">
            <thead class="bg-zinc-50">
                <tr>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-zinc-500 uppercase tracking-wider">ID</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-zinc-500 uppercase tracking-wider">Tên danh mục</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-zinc-500 uppercase tracking-wider">Mô tả</th>
                    <th scope="col" class="px-6 py-4 text-center text-xs font-bold text-zinc-500 uppercase tracking-wider">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200 bg-white">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-zinc-50 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-zinc-900">#@item.Id</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-zinc-800">@item.Name</td>
                        <td class="px-6 py-4 text-sm text-zinc-500 max-w-xs truncate">@item.Description</td>
                        <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                            @if (User.IsInRole("Administrator"))
                            {
                                <div class="flex justify-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-indigo-600 hover:text-indigo-900 bg-indigo-50 px-3 py-1 rounded-md font-bold transition-all">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-rose-600 hover:text-rose-900 bg-rose-50 px-3 py-1 rounded-md font-bold transition-all" onclick="return confirm('Xác nhận xóa?')">Xóa</a>
                                </div>
                            }
                            else
                            {
                                <span class="inline-flex items-center rounded-full bg-zinc-100 px-3 py-1 text-xs font-bold text-zinc-600">
                                    <i class="bi bi-lock-fill mr-1"></i> Chỉ xem
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>