<!DOCTYPE html>
<html lang="en" class="h-full bg-zinc-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ThinhCMS Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .active-nav {
            background: #059669;
            color: white !important;
        }
    </style>
</head>
<body class="h-full overflow-hidden text-zinc-900 antialiased">

    <div class="flex h-full w-full overflow-hidden">
        <aside class="flex h-full w-64 flex-col border-r border-zinc-200 bg-white shadow-sm flex-shrink-0">
            <div class="flex h-16 items-center px-6 border-b border-zinc-100">
                <i class="bi bi-layers-fill text-emerald-600 text-2xl mr-2"></i>
                <span class="text-lg font-bold text-zinc-900">Thinh<span class="text-emerald-600">.CMS</span></span>
            </div>

            <nav class="flex-1 space-y-1 p-4 overflow-y-auto">
                @{
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();

                    // Kiểm tra quyền hạn của người dùng đăng nhập để ẩn/hiện menu
                    var isAuthorizedForProducts = User.Identity?.IsAuthenticated == true &&
                    (User.IsInRole("Administrator") ||
                    User.IsInRole("Editor") ||
                    User.FindFirst("Role")?.Value == "Administrator" ||
                    User.FindFirst("Role")?.Value == "Editor");
                }

                <a asp-controller="Home" asp-action="Index" class="flex items-center rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition-all duration-200 @(currentController == "Home" ? "active-nav" : "text-zinc-600 hover:bg-emerald-50 hover:text-emerald-700")">
                    <i class="bi bi-speedometer2 text-lg mr-3"></i> Trang chủ
                </a>
                <a asp-controller="Category" asp-action="Index" class="flex items-center rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition-all duration-200 @(currentController == "Category" ? "active-nav" : "text-zinc-600 hover:bg-emerald-50 hover:text-emerald-700")">
                    <i class="bi bi-tags text-lg mr-3"></i> Danh mục
                </a>
                <a asp-controller="Post" asp-action="Index" class="flex items-center rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition-all duration-200 @(currentController == "Post" ? "active-nav" : "text-zinc-600 hover:bg-emerald-50 hover:text-emerald-700")">
                    <i class="bi bi-newspaper text-lg mr-3"></i> Bài viết
                </a>
                <a asp-controller="Banner" asp-action="Index" class="flex items-center rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition-all duration-200 @(currentController == "Banner" ? "active-nav" : "text-zinc-600 hover:bg-emerald-50 hover:text-emerald-700")">
                    <i class="bi bi-images text-lg mr-3"></i> Banner
                </a>

                @if (isAuthorizedForProducts)
                {
                    <a asp-controller="CategoryProduct" asp-action="Index" class="flex items-center rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition-all duration-200 @(currentController == "CategoryProduct" ? "active-nav" : "text-zinc-600 hover:bg-emerald-50 hover:text-emerald-700")">
                        <i class="bi bi-collection-fill text-lg mr-3"></i> DM Sản phẩm
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="flex items-center rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition-all duration-200 @(currentController == "Product" ? "active-nav" : "text-zinc-600 hover:bg-emerald-50 hover:text-emerald-700")">
                        <i class="bi bi-box-seam text-lg mr-3"></i> Sản phẩm
                    </a>
                    <a asp-controller="Order" asp-action="Index" class="flex items-center rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition-all duration-200 @(currentController == "Order" ? "active-nav" : "text-zinc-600 hover:bg-emerald-50 hover:text-emerald-700")">
                        <i class="bi bi-clipboard2-heart text-lg mr-3"></i> Sổ đơn hàng
                    </a>
                    <a asp-controller="Customer" asp-action="Index" class="flex items-center rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition-all duration-200 @(currentController == "Customer" ? "active-nav" : "text-zinc-600 hover:bg-emerald-50 hover:text-emerald-700")">
                        <i class="bi bi-people text-lg mr-3"></i> Khách hàng
                    </a>
                }

                <a asp-controller="User" asp-action="Index" class="flex items-center rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition-all duration-200 @(currentController == "User" ? "active-nav" : "text-zinc-600 hover:bg-emerald-50 hover:text-emerald-700")">
                    <i class="bi bi-person-gear text-lg mr-3"></i> Người dùng
                </a>
            </nav>

            <div class="p-4 border-t border-zinc-100">
                <div class="bg-zinc-900 rounded-xl p-4 text-white shadow-inner">
                    <p class="text-[10px] uppercase tracking-widest text-zinc-400 font-bold mb-1">Sinh viên thực hiện</p>
                    <p class="font-bold text-sm text-zinc-100">Lê Công Thịnh</p>
                    <p class="text-xs text-zinc-400 mt-0.5">MSSV: 2123110063</p>
                    <p class="text-[11px] text-emerald-400 font-medium mt-2 flex items-center gap-1">
                        <i class="bi bi-gradient"></i> CCQ2311B
                    </p>
                </div>
            </div>
        </aside>

        <div class="flex flex-1 flex-col h-full overflow-hidden bg-zinc-50">
            <header class="flex h-16 items-center justify-between bg-white border-b border-zinc-200 px-8 flex-shrink-0">
                <h1 class="text-lg font-semibold text-zinc-800">@ViewData["Title"]</h1>

                <div class="flex items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        // Bộ lọc động quét dữ liệu từ Cookie Identity
                        var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "Thinh Le Cong";
                        var roleName = User.FindFirst("Role")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Administrator";

                        <div class="flex items-center text-sm gap-4">
                            <div class="flex items-center gap-3 bg-zinc-50 border border-zinc-200/80 px-4 py-1.5 rounded-full">
                                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                                    <i class="bi bi-person-fill text-sm"></i>
                                </div>
                                <div class="flex flex-col text-left">
                                    <span class="text-xs font-bold text-zinc-800 leading-tight">@fullName</span>
                                    <span class="text-[10px] font-semibold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded mt-0.5 w-max border border-emerald-200/50">
                                        🔑 @roleName
                                    </span>
                                </div>
                            </div>

                            <div class="h-6 w-px bg-zinc-200"></div>

                            <a asp-controller="Account" asp-action="Logout" class="flex items-center gap-1.5 text-zinc-500 hover:text-red-600 font-medium transition-colors no-underline text-sm">
                                <i class="bi bi-box-arrow-right text-base"></i>
                                <span>Đăng xuất</span>
                            </a>
                        </div>
                    }
                </div>
            </header>

            <main class="flex-1 overflow-y-auto p-6">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>