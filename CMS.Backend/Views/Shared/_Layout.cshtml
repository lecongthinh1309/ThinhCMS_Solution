<!DOCTYPE html>
<html lang="en" class="h-full bg-zinc-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ThinhCMS Admin</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .active-nav {
            background: #059669;
            color: white !important;
        }
        /* Emerald-600 */
    </style>
</head>
<body class="h-full overflow-hidden text-zinc-900 antialiased">

    <div class="flex h-full w-full overflow-hidden">
        <aside class="flex h-full w-64 flex-col border-r border-zinc-200 bg-white shadow-sm flex-shrink-0">
            <div class="flex h-16 items-center px-6 border-b border-zinc-100">
                <i class="bi bi-layers-fill text-emerald-600 text-2xl mr-2"></i>
                <span class="text-lg font-bold text-zinc-900">Thinh<span class="text-emerald-600">.CMS</span></span>
            </div>

            <nav class="flex-1 space-y-1 p-4">
                @{
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                    var menuItems = new[] {
                                new { Icon = "speedometer2", Name = "Trang chủ", Controller = "Home" },
                                new { Icon = "tags", Name = "Danh mục", Controller = "Category" },
                                new { Icon = "newspaper", Name = "Bài viết", Controller = "Post" },
                                new { Icon = "collection-fill", Name = "DM Sản phẩm", Controller = "CategoryProduct" },
                                new { Icon = "box-seam", Name = "Sản phẩm", Controller = "Product" },
                                new { Icon = "clipboard2-heart", Name = "Sổ đơn hàng", Controller = "Order" },
                                new { Icon = "person-gear", Name = "Người dùng", Controller = "User" },
                                new { Icon = "people", Name = "Khách hàng", Controller = "Customer" },

                                };
                }

                @foreach (var item in menuItems)
                {
                    <a asp-controller="@item.Controller" asp-action="Index"
                       class="flex items-center rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition-all duration-200
                           @(currentController == item.Controller ? "active-nav" : "text-zinc-600 hover:bg-emerald-50 hover:text-emerald-700")">
                        <i class="bi bi-@item.Icon text-lg mr-3"></i> @item.Name
                    </a>
                }
            </nav>

            <div class="p-4 border-t border-zinc-100">
                <div class="bg-zinc-900 rounded-xl p-4 text-white">
                    <p class="text-[10px] uppercase tracking-widest text-zinc-400 font-bold mb-1">Sinh viên</p>
                    <p class="font-bold text-sm"></p>
                    <p class="text-xs text-emerald-400">CCQ2311B</p>
                </div>
            </div>
        </aside>

        <div class="flex flex-1 flex-col h-full overflow-hidden bg-zinc-50">
            <header class="flex h-16 items-center justify-between bg-white border-b border-zinc-200 px-8">
                <h1 class="text-lg font-semibold text-zinc-800">@ViewData["Title"]</h1>

                <div class="flex items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="flex items-center text-sm text-zinc-600 font-medium">
                            <span class="mr-3">@User.FindFirst("FullName")?.Value</span>
                            <a asp-controller="Account" asp-action="Logout" class="text-red-500 hover:text-red-700 font-bold">
                                <i class="bi bi-box-arrow-right">Đăng xuất</i>
                            </a>
                        </div>
                    }
                </div>
            </header>

            <main class="flex-1 overflow-y-auto p-6">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>