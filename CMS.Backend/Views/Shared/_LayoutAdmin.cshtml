<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ThinhCMS Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
            overflow-x: hidden;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .admin-sidebar {
            width: 260px;
            min-width: 260px;
            background-color: #212529;
            color: #fff;
            display: flex;
            flex-direction: column;
            border-right: 1px solid #2c3136;
        }

        .sidebar-brand {
            padding: 20px;
            font-size: 1.25rem;
            font-weight: 700;
            background-color: #1a1d20;
            border-bottom: 1px solid #2c3136;
        }

        .sidebar-menu {
            list-style: none;
            padding: 15px 0;
            margin: 0;
        }

            .sidebar-menu li {
                padding: 2px 15px;
            }

                .sidebar-menu li a {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 15px;
                    color: #adb5bd;
                    text-decoration: none;
                    border-radius: 6px;
                    font-size: 0.95rem;
                    transition: all 0.2s ease;
                }

                    .sidebar-menu li a:hover, .sidebar-menu li.active a {
                        color: #fff;
                        background-color: #2c3136;
                        font-weight: 500;
                    }

        .admin-main {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            background-color: #fdfdfd;
        }

        .admin-topbar {
            background-color: #fff;
            padding: 15px 30px;
            border-bottom: 1px solid #dee2e6;
        }

        .admin-content {
            padding: 30px;
            flex-grow: 1;
        }

        .admin-footer {
            background-color: #fff;
            padding: 15px 30px;
            border-top: 1px solid #dee2e6;
        }
    </style>
</head>
<body>

    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            <div class="sidebar-brand"><span class="text-white">ThinhCMS Admin</span></div>
            <ul class="sidebar-menu">
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i><span>Bảng điều khiển</span></a>
                </li>
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" ? "active" : "")">
                    <a asp-controller="Category" asp-action="Index"><i class="bi bi-grid-3x3-gap"></i><span>Quản lý Danh mục</span></a>
                </li>
                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Post" ? "active" : "")">
                    <a asp-controller="Post" asp-action="Index"><i class="bi bi-file-earmark-richtext"></i><span>Quản lý Bài viết</span></a>
                </li>

                @* Phân quyền cho Sản phẩm *@
                @if (User.IsInRole("Administrator") || User.IsInRole("Editor"))
                {
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "CategoryProduct" ? "active" : "")">
                        <a asp-controller="CategoryProduct" asp-action="Index"><i class="bi bi-tags"></i><span>Danh mục Sản phẩm</span></a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")">
                        <a asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam"></i><span>Quản lý Sản phẩm</span></a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Order" ? "active" : "")">
                        <a asp-controller="Order" asp-action="Index"><i class="bi bi-clipboard2-heart"></i><span>Sổ đơn hàng</span></a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customer" ? "active" : "")">
                        <a asp-controller="Customer" asp-action="Index"><i class="bi bi-clipboard2-heart"></i><span>Customer</span></a>
                    </li>
                }

                <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" ? "active" : "")">
                    <a asp-controller="User" asp-action="Index"><i class="bi bi-people"></i><span>Quản lý Thành viên</span></a>
                </li>

                @if (User.Identity.IsAuthenticated)
                {
                    <li class="mt-4 border-top border-secondary pt-2">
                        <a asp-controller="Account" asp-action="Logout" class="text-danger fw-semibold">
                            <i class="bi bi-box-arrow-right text-danger"></i><span>Đăng xuất</span>
                        </a>
                    </li>
                }
            </ul>
        </aside>

        <main class="admin-main">
            <header class="admin-topbar d-flex justify-content-between align-items-center shadow-sm">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb m-0 bg-transparent p-0">
                        <li class="breadcrumb-item text-muted">@ViewContext.RouteData.Values["Controller"]</li>
                        <li class="breadcrumb-item active text-dark">@ViewData["Title"]</li>
                    </ol>
                </nav>

                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="text-end small me-2">
                            <span class="d-block text-dark fw-semibold">Chào, @User.FindFirst("FullName")?.Value</span>
                            <span class="text-muted d-block" style="font-size: 0.8rem;">Quyền: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </div>
                    }
                    <div class="d-flex align-items-center border-start ps-3">
                        <span class="badge bg-light text-dark border me-2 px-3 py-2 fw-semibold" style="font-size: 0.9rem;">Lê Công Thịnh</span>
                        <span class="text-muted fw-bold small">2123110063</span>
                    </div>
                </div>
            </header>

            <div class="admin-content">
                @RenderBody()
            </div>

            <footer class="admin-footer text-muted">
                <div class="d-flex justify-content-between align-items-center small">
                    <span>&copy; 2026 - <span class="fw-semibold text-dark">Cao đẳng Công Thương TPHCM</span></span>
                </div>
            </footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>