@{
    ViewData["Title"] = "Từ chối truy cập";
    Layout = null; // Dùng layout riêng để không bị ảnh hưởng bởi layout khác
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Truy cập bị từ chối</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .error-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 48px;
            border-radius: 24px;
            text-align: center;
            max-width: 500px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        }

        .icon-box {
            font-size: 4rem;
            color: #ef4444;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            color: #ef4444;
        }

        p {
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 30px;
        }

        .btn-home {
            display: inline-block;
            background: #6366f1;
            color: white;
            padding: 12px 32px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }

            .btn-home:hover {
                background: #4f46e5;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="icon-box">🚫</div>
        <h1>403 - Lỗi truy cập</h1>
        <p>Bạn không có quyền hạn để thực hiện thao tác này. Vui lòng liên hệ quản trị viên hệ thống.</p>
        <a href="/" class="btn-home">Quay lại trang chủ</a>
    </div>
</body>
</html>