@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-zinc-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký thành viên - ThinhCMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="h-full flex items-center justify-center font-['Inter'] antialiased">
    <div class="w-full max-w-md p-8 bg-white border border-zinc-200 shadow-sm rounded-2xl">
        <h2 class="text-2xl font-bold text-center text-zinc-900 mb-2">Đăng ký thành viên</h2>
        <p class="text-sm text-center text-zinc-500 mb-6">Tạo tài khoản mua sắm tích hợp hệ thống</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-600 rounded-lg text-sm">
                @Html.ValidationSummary(true, "")
            </div>
        }

        <form asp-controller="Account" asp-action="Register" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-sm font-medium text-zinc-700 mb-1">Họ và tên</label>
                <input type="text" name="fullName" required placeholder="Lê Công Thịnh" class="w-full px-4 py-2 border border-zinc-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-zinc-700 mb-1">Email đăng nhập</label>
                <input type="email" name="email" required placeholder="viethan@example.com" class="w-full px-4 py-2 border border-zinc-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-zinc-700 mb-1">Số điện thoại</label>
                <input type="tel" name="phone" required placeholder="0901234567" class="w-full px-4 py-2 border border-zinc-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-zinc-700 mb-1">Mật khẩu bảo mật</label>
                <input type="password" name="password" required minlength="6" placeholder="Tối thiểu 6 ký tự" class="w-full px-4 py-2 border border-zinc-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500" />
            </div>
            <button type="submit" class="w-full py-2.5 bg-emerald-600 text-white font-semibold rounded-lg hover:bg-emerald-700 transition-colors shadow-sm">
                Xác Nhận Đăng Ký
            </button>
        </form>
        <div class="mt-4 text-center">
            <a asp-action="Login" class="text-xs text-zinc-500 hover:underline">Đã có tài khoản? Quay lại đăng nhập</a>
        </div>
    </div>
</body>
</html>