@model CMS.Backend.Models.DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<div class="px-6 py-6 max-w-7xl mx-auto font-sans">
    
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-800 flex items-center">
            <i class="fas fa-tachometer-alt text-blue-600 mr-2"></i> Bảng điều khiển
        </h1>
        <p class="text-sm text-slate-500 mt-1">Tổng quan hệ thống CMS — Cập nhật lúc @DateTime.Now.ToString("HH:mm, dd/MM/yyyy")</p>
    </div>

    <!-- Doanh thu & Trạng thái Đơn hàng -->
    <div class="bg-[#1e293b] rounded-2xl p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-center mb-8 shadow-lg relative overflow-hidden">
        <!-- Decoration -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-white opacity-5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
        
        <div class="mb-6 md:mb-0 z-10">
            <p class="text-slate-400 text-xs font-bold tracking-wider mb-2 uppercase">Tổng doanh thu (Đơn hoàn thành)</p>
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-3">@Model.TotalRevenue.ToString("N0") <span class="underline decoration-2 underline-offset-4">đ</span></h2>
            <p class="text-emerald-400 text-sm font-medium flex items-center">
                <i class="fas fa-check-circle mr-1.5"></i> @Model.OrdersCompleted đơn hàng đã hoàn thành
            </p>
        </div>

        <div class="flex gap-4 w-full md:w-auto overflow-x-auto pb-2 md:pb-0 z-10">
            <!-- Chờ duyệt -->
            <div class="bg-white rounded-xl px-6 py-4 flex flex-col items-center justify-center min-w-[140px] shadow-sm">
                <span class="text-3xl font-black text-amber-500 mb-1">@Model.OrdersPending</span>
                <span class="text-slate-500 text-xs font-medium flex items-center"><i class="far fa-clock mr-1"></i> Chờ duyệt</span>
            </div>
            <!-- Đang giao -->
            <div class="bg-white rounded-xl px-6 py-4 flex flex-col items-center justify-center min-w-[140px] shadow-sm">
                <span class="text-3xl font-black text-blue-500 mb-1">@Model.OrdersShipping</span>
                <span class="text-slate-500 text-xs font-medium flex items-center"><i class="fas fa-truck mr-1"></i> Đang giao</span>
            </div>
            <!-- Hoàn thành -->
            <div class="bg-white rounded-xl px-6 py-4 flex flex-col items-center justify-center min-w-[140px] shadow-sm">
                <span class="text-3xl font-black text-emerald-500 mb-1">@Model.OrdersCompleted</span>
                <span class="text-slate-500 text-xs font-medium flex items-center"><i class="fas fa-check mr-1"></i> Hoàn thành</span>
            </div>
        </div>
    </div>

    <!-- Số liệu tổng quan (6 khối) -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
        <!-- Card 1 -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 w-16 h-16 bg-blue-50 rounded-full group-hover:scale-150 transition-transform duration-500"></div>
            <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center text-xl mb-4 relative z-10">
                <i class="fas fa-box"></i>
            </div>
            <h3 class="text-2xl font-black text-slate-800 relative z-10">@Model.TotalProducts</h3>
            <p class="text-slate-500 text-sm font-medium relative z-10">Sản phẩm</p>
        </div>
        <!-- Card 2 -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 w-16 h-16 bg-emerald-50 rounded-full group-hover:scale-150 transition-transform duration-500"></div>
            <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center text-xl mb-4 relative z-10">
                <i class="fas fa-receipt"></i>
            </div>
            <h3 class="text-2xl font-black text-slate-800 relative z-10">@Model.TotalOrders</h3>
            <p class="text-slate-500 text-sm font-medium relative z-10">Đơn hàng</p>
        </div>
        <!-- Card 3 -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 w-16 h-16 bg-purple-50 rounded-full group-hover:scale-150 transition-transform duration-500"></div>
            <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center text-xl mb-4 relative z-10">
                <i class="fas fa-users"></i>
            </div>
            <h3 class="text-2xl font-black text-slate-800 relative z-10">@Model.TotalCustomers</h3>
            <p class="text-slate-500 text-sm font-medium relative z-10">Khách hàng</p>
        </div>
        <!-- Card 4 -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 w-16 h-16 bg-amber-50 rounded-full group-hover:scale-150 transition-transform duration-500"></div>
            <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center text-xl mb-4 relative z-10">
                <i class="fas fa-file-alt"></i>
            </div>
            <h3 class="text-2xl font-black text-slate-800 relative z-10">@Model.TotalPosts</h3>
            <p class="text-slate-500 text-sm font-medium relative z-10">Bài viết</p>
        </div>
        <!-- Card 5 -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 w-16 h-16 bg-rose-50 rounded-full group-hover:scale-150 transition-transform duration-500"></div>
            <div class="w-12 h-12 bg-rose-100 text-rose-600 rounded-xl flex items-center justify-center text-xl mb-4 relative z-10">
                <i class="fas fa-tags"></i>
            </div>
            <h3 class="text-2xl font-black text-slate-800 relative z-10">@Model.TotalCategories</h3>
            <p class="text-slate-500 text-sm font-medium relative z-10">Danh mục</p>
        </div>
        <!-- Card 6 -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 w-16 h-16 bg-cyan-50 rounded-full group-hover:scale-150 transition-transform duration-500"></div>
            <div class="w-12 h-12 bg-cyan-100 text-cyan-600 rounded-xl flex items-center justify-center text-xl mb-4 relative z-10">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h3 class="text-2xl font-black text-slate-800 relative z-10">@Model.TotalUsers</h3>
            <p class="text-slate-500 text-sm font-medium relative z-10">Thành viên</p>
        </div>
    </div>

    <!-- Biểu đồ & Top Sản phẩm -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Biểu đồ 7 ngày -->
        <div class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
            <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                <i class="fas fa-chart-bar text-blue-600 mr-2"></i> Doanh thu 7 ngày gần nhất
            </h3>
            <div class="relative h-80 w-full">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Top sản phẩm bán chạy -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
            <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                <i class="fas fa-trophy text-blue-600 mr-2"></i> Sản phẩm bán chạy
            </h3>
            
            <div class="space-y-6">
                @if (Model.TopProducts.Any())
                {
                    int rank = 1;
                    foreach (var p in Model.TopProducts)
                    {
                        string badgeColor = rank == 1 ? "bg-amber-400" : rank == 2 ? "bg-slate-400" : "bg-amber-700";
                        <div class="flex items-center gap-4">
                            <div class="flex-shrink-0 w-6 h-6 rounded flex items-center justify-center text-white text-xs font-bold @badgeColor">
                                @rank
                            </div>
                            <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-slate-100 overflow-hidden border border-slate-200">
                                <img src="@p.ImageUrl" alt="@p.ProductName" class="w-full h-full object-cover" onerror="this.src='/images/no-image.png'" />
                            </div>
                            <div class="flex-grow min-w-0">
                                <h4 class="text-sm font-bold text-slate-800 truncate" title="@p.ProductName">@p.ProductName</h4>
                                <p class="text-xs text-slate-500 mt-0.5">Đã bán @p.TotalSold sản phẩm</p>
                            </div>
                            <div class="flex-shrink-0 text-right">
                                <span class="text-sm font-bold text-emerald-600">@p.TotalRevenue.ToString("N0")đ</span>
                            </div>
                        </div>
                        rank++;
                    }
                }
                else
                {
                    <div class="text-center py-8">
                        <i class="fas fa-box-open text-3xl text-slate-300 mb-2"></i>
                        <p class="text-sm text-slate-500">Chưa có dữ liệu bán hàng</p>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('revenueChart').getContext('2d');
            
            const labels = @Html.Raw(Json.Serialize(Model.DailyRevenues.Select(x => x.Date)));
            const data = @Html.Raw(Json.Serialize(Model.DailyRevenues.Select(x => x.Revenue)));

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: data,
                        backgroundColor: '#3b82f6', // Tailwind blue-500
                        borderRadius: 6,
                        barThickness: 40,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1e293b',
                            padding: 12,
                            titleFont: { size: 13, family: "'Inter', sans-serif" },
                            bodyFont: { size: 14, weight: 'bold', family: "'Inter', sans-serif" },
                            callbacks: {
                                label: function(context) {
                                    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.raw);
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            border: { display: false },
                            grid: { color: '#f1f5f9', drawBorder: false },
                            ticks: {
                                color: '#64748b',
                                font: { family: "'Inter', sans-serif", size: 11 },
                                callback: function(value) {
                                    if(value === 0) return '0';
                                    return new Intl.NumberFormat('vi-VN').format(value);
                                }
                            }
                        },
                        x: {
                            border: { display: false },
                            grid: { display: false },
                            ticks: {
                                color: '#64748b',
                                font: { family: "'Inter', sans-serif", size: 12, weight: 'bold' }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
