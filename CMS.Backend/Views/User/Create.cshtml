@model CMS.Data.Entities.User

@{
    ViewData["Title"] = "Thêm thành viên";
}

<div class="container mt-4">
    <div class="card shadow border-0 mx-auto rounded-3" style="max-width: 600px;">
        <div class="card-header bg-success text-white fw-bold py-3">
            <h5 class="mb-0 text-uppercase"><i class="bi bi-person-plus-fill"></i> Thêm thành viên mới</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Username" class="form-label fw-bold text-dark">Tên Đăng Nhập</label>
                    <input asp-for="Username" class="form-control py-2" placeholder="Ví dụ: admin_thinh" required />
                </div>

                <div class="mb-3">
                    <label asp-for="PasswordHash" class="form-label fw-bold text-dark">Mật Khẩu</label>
                    <input asp-for="PasswordHash" type="password" class="form-control py-2" placeholder="Nhập mật khẩu cho tài khoản..." required />
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-bold text-dark">Họ Và Tên</label>
                    <input asp-for="FullName" class="form-control py-2" placeholder="Ví dụ: Lê Công Thịnh" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-bold text-dark">Quyền Hạn Hệ Thống</label>
                    <select asp-for="Role" class="form-select py-2" required>
                        <option value="">-- Chọn quyền hạn --</option>
                        <option value="Administrator">Administrator</option>
                        <option value="Editor">Editor</option>
                        <option value="Author">Author</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between mt-4 border-top pt-3">
                    <a href="/User" class="btn btn-secondary px-4 py-2">Hủy Bỏ</a>
                    <button type="submit" class="btn btn-success px-4 py-2 fw-bold">Lưu Thành Viên</button>
                </div>
            </form>
        </div>
    </div>
</div>