@{
    Layout = "_Layout";
}
@model IEnumerable<CMS.Data.Entities.User>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="px-4 sm:px-6 lg:px-8">
    <div class="sm:flex sm:items-center justify-between mb-8">
        <div>
            <h2 class="text-2xl font-bold text-zinc-900">Quản lý thành viên</h2>
            <p class="mt-2 text-sm text-zinc-600">Phân quyền và quản lý tài khoản quản trị viên.</p>
        </div>
        <a href="/User/Create" class="inline-flex items-center rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700 transition-all">
            <i class="bi bi-person-plus mr-2"></i> Thêm thành viên
        </a>
    </div>

    <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-zinc-200">
            <thead class="bg-zinc-50">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-bold text-zinc-500 uppercase">Username</th>
                    <th class="px-6 py-4 text-left text-xs font-bold text-zinc-500 uppercase">Họ và Tên</th>
                    <th class="px-6 py-4 text-left text-xs font-bold text-zinc-500 uppercase">Quyền hạn</th>
                    <th class="px-6 py-4 text-center text-xs font-bold text-zinc-500 uppercase">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200">
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="px-6 py-4 font-bold text-zinc-900">@user.Username</td>
                        <td class="px-6 py-4 text-zinc-600">@user.FullName</td>
                        <td class="px-6 py-4">
                            @if (user.Role == "Administrator")
                            {
                                <span class="px-2 py-1 rounded bg-rose-100 text-rose-700 text-xs font-bold">ADMIN</span>
                            }
                            else if (user.Role == "Editor")
                            {

                                <span class="px-2 py-1 rounded bg-sky-100 text-sky-700 text-xs font-bold">EDITOR</span>
                            }
                            else
                            {

                                <span class="px-2 py-1 rounded bg-zinc-100 text-zinc-700 text-xs font-bold">@user.Role</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-center">
                            <a href="/User/Edit/@user.Id" class="text-indigo-600 font-bold px-3">Sửa</a>
                            <a href="/User/Delete/@user.Id" class="text-rose-600 font-bold px-3" onclick="return confirm('Xóa người dùng này?');">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>