@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Thêm bài viết";
}

<div class="container mt-4">
    <div class="card shadow mx-auto" style="max-width: 650px;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0 fw-bold">THÊM BÀI VIẾT MỚI</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Danh mục bài viết</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Tiêu đề bài viết</label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề bài viết..." required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Chọn tệp hình ảnh</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label fw-bold">Nội dung bài viết</label>
                    <textarea asp-for="Content" class="form-control" rows="6" placeholder="Nhập nội dung chi tiết bài viết..." required></textarea>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="/Post" class="btn btn-secondary px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-success px-4">Đăng bài viết</button>
                </div>
            </form>
        </div>
    </div>
</div>