@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Thêm bài viết";
}

<div class="max-w-2xl mx-auto mt-8 bg-white p-8 rounded-xl shadow-md border border-gray-100">
    <h2 class="text-xl font-bold text-gray-800 mb-6 border-b pb-3 uppercase tracking-wide">Thêm bài viết mới</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-5">
        @Html.AntiForgeryToken()

        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Danh mục bài viết</label>
            <select asp-for="CategoryId" class="w-full border border-gray-300 px-3 py-2 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" asp-items="ViewBag.Categories" required>
                <option value="">-- Chọn danh mục --</option>
            </select>
        </div>

        <div>
            <label asp-for="Title" class="block text-sm font-semibold text-gray-700 mb-1">Tiêu đề bài viết</label>
            <input asp-for="Title" class="w-full border border-gray-300 px-3 py-2 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" placeholder="Nhập tiêu đề bài viết..." required />
        </div>

        <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Chọn tệp hình ảnh</label>
            <input type="file" name="imageFile" class="w-full border border-gray-300 px-3 py-2 rounded-lg text-sm text-gray-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" accept="image/*" required />
        </div>

        <div>
            <label asp-for="Content" class="block text-sm font-semibold text-gray-700 mb-1">Nội dung bài viết</label>
            <textarea asp-for="Content" id="Content" rows="6" class="w-full border border-gray-300 px-3 py-2 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" placeholder="Nhập nội dung chi tiết bài viết..." required></textarea>
        </div>

        <div class="flex justify-between items-center pt-4 border-t border-gray-100">
            <a href="/Post" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-4 py-2 rounded-lg text-sm transition">Hủy bỏ</a>
            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-semibold px-5 py-2 rounded-lg text-sm shadow transition">Đăng bài viết</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/4.22.1/full/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('Content', {
            language: 'vi',
            filebrowserUploadUrl: '/api/Upload',
            filebrowserUploadMethod: 'form'
        });
    </script>
}