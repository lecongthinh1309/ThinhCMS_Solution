@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="text-danger fw-bold m-0" style="text-transform: uppercase; font-size: 1.75rem;">
            @ViewBag.CurrentCategoryName
        </h1>
        <a href="/Post/Create" class="btn btn-success d-flex align-items-center gap-2 shadow-sm px-3 py-2 rounded-3 fw-bold">
            <i class="bi bi-plus-circle"></i> Thêm bài viết mới
        </a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden post-card d-flex flex-column">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="height: 190px; object-fit: cover;">

                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <span class="badge bg-info text-dark mb-2">
                                @item.Category?.Name
                            </span>

                            <h5 class="card-title text-primary fw-bold mb-3">
                                @item.Title
                            </h5>

                            <p class="card-text text-muted small mb-2">
                                @item.Content
                            </p>
                        </div>

                        <div>
                            <p class="text-muted mb-3" style="font-size: 0.85rem;">
                                Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                            </p>

                            <div class="d-flex gap-1 justify-content-start">
                                <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm px-2">Xem chi tiết</a>
                                <a href="/Post/Edit/@item.Id" class="btn btn-warning btn-sm px-2 text-dark">Sửa</a>
                                <a href="/Post/Delete/@item.Id" class="btn btn-danger btn-sm px-2"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">Xóa</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .post-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .post-card:hover {
                transform: translateY(-5px);
                box-shadow: 0.5rem 1rem 1rem rgba(0, 0, 0, 0.1) !important;
            }

        .card-title {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 3rem;
        }

        .card-text {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 4.5rem;
        }
    </style>
}