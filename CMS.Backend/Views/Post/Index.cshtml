@{
    Layout = "_Layout";
}
@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    int? categoryId = ViewBag.CategoryId;
}

<div class="px-4 sm:px-6 lg:px-8">
    <div class="sm:flex sm:items-center justify-between mb-8">
        <div>
            <h2 class="text-2xl font-bold text-zinc-900 uppercase">@ViewBag.CurrentCategoryName</h2>
            <p class="mt-2 text-sm text-zinc-500">
                Tổng cộng <strong>@totalItems</strong> bài viết — Trang <strong>@currentPage</strong>/@totalPages
            </p>
        </div>
        <div class="mt-4 sm:mt-0">
            <a asp-controller="Post" asp-action="Create" class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-all">
                <i class="bi bi-plus-lg mr-2"></i> Thêm bài viết mới
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model)
        {
            <div class="group flex flex-col rounded-xl border border-zinc-200 bg-white shadow-sm overflow-hidden hover:shadow-md transition-all duration-300">
                <div class="relative h-48 overflow-hidden">
                    <img src="@item.ImageUrl" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="@item.Title">
                    <div class="absolute top-3 left-3">
                        <span class="inline-flex items-center rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-indigo-700 backdrop-blur-sm">
                            @item.Category?.Name
                        </span>
                    </div>
                </div>

                <div class="flex flex-1 flex-col p-5">
                    <h5 class="mb-2 text-base font-bold text-zinc-900 line-clamp-2 h-12">@item.Title</h5>
                    <p class="mb-4 text-sm text-zinc-500 line-clamp-3 flex-1">@item.Content</p>

                    <div class="mt-auto pt-4 border-t border-zinc-100">
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-zinc-400 font-medium">@item.CreatedDate.ToString("dd/MM/yyyy")</span>
                            <div class="flex gap-2">
                                <a asp-controller="Post" asp-action="Edit" asp-route-id="@item.Id" class="text-amber-600 hover:text-amber-700 font-bold text-xs">Sửa</a>
                                <a asp-controller="Post" asp-action="Delete" asp-route-id="@item.Id" class="text-rose-600 hover:text-rose-700 font-bold text-xs" onclick="return confirm('Xác nhận xóa?');">Xóa</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ===== THANH PHÂN TRANG ===== *@
    @if (totalPages > 1)
    {
        <div class="flex items-center justify-center gap-2 mt-10 flex-wrap">
            @* Nút Trước *@
            @if (currentPage > 1)
            {
                <a asp-action="Index" asp-route-id="@categoryId" asp-route-page="@(currentPage - 1)"
                   class="inline-flex items-center gap-1 px-3 py-2 rounded-lg bg-white border border-zinc-200 text-zinc-600 hover:bg-indigo-50 hover:border-indigo-300 text-sm font-medium transition-all shadow-sm">
                    <i class="bi bi-chevron-left"></i> Trước
                </a>
            }
            else
            {
                <span class="inline-flex items-center gap-1 px-3 py-2 rounded-lg bg-zinc-100 border border-zinc-200 text-zinc-400 text-sm font-medium cursor-not-allowed">
                    <i class="bi bi-chevron-left"></i> Trước
                </span>
            }

            @* Số trang *@
            @for (int p = 1; p <= totalPages; p++)
            {
                if (p == currentPage)
                {
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-600 text-white text-sm font-bold shadow">
                        @p
                    </span>
                }
                else if (p == 1 || p == totalPages || (p >= currentPage - 2 && p <= currentPage + 2))
                {
                    <a asp-action="Index" asp-route-id="@categoryId" asp-route-page="@p"
                       class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-white border border-zinc-200 text-zinc-700 hover:bg-indigo-50 hover:border-indigo-300 text-sm font-medium transition-all shadow-sm">
                        @p
                    </a>
                }
                else if (p == currentPage - 3 || p == currentPage + 3)
                {
                    <span class="inline-flex items-center justify-center w-10 h-10 text-zinc-400 text-sm">...</span>
                }
            }

            @* Nút Sau *@
            @if (currentPage < totalPages)
            {
                <a asp-action="Index" asp-route-id="@categoryId" asp-route-page="@(currentPage + 1)"
                   class="inline-flex items-center gap-1 px-3 py-2 rounded-lg bg-white border border-zinc-200 text-zinc-600 hover:bg-indigo-50 hover:border-indigo-300 text-sm font-medium transition-all shadow-sm">
                    Sau <i class="bi bi-chevron-right"></i>
                </a>
            }
            else
            {
                <span class="inline-flex items-center gap-1 px-3 py-2 rounded-lg bg-zinc-100 border border-zinc-200 text-zinc-400 text-sm font-medium cursor-not-allowed">
                    Sau <i class="bi bi-chevron-right"></i>
                </span>
            }
        </div>
        <p class="text-center text-xs text-zinc-400 mt-3">Trang @currentPage / @totalPages (@totalItems bài viết)</p>
    }
</div>